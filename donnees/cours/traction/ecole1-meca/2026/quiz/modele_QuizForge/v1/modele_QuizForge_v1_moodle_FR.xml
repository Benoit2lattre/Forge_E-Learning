    <generalfeedback format="html"><text><![CDATA[<div style="padding:.6em .9em;border-left:4px solid #470A68;background:#F4EEF8;">f = ω / 2π, en Hz.</div>]]></text></generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <tags><tag><text>TRACTION</text></tag><tag><text>MEC3-TR</text></tag><tag><text>MEC3</text></tag><tag><text>QCM</text></tag></tags>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html"><text>√(k/m)</text><feedback format="html"><text>C'est la pulsation, en rad/s.</text></feedback></answer>
    <answer fraction="100" format="html"><text>√(k/m) / 2π</text><feedback format="html"><text></text></feedback></answer>
    <answer fraction="0" format="html"><text>2π √(k/m)</text><feedback format="html"><text>Vous avez multiplié au lieu de diviser par 2π.</text></feedback></answer>
  </question>
